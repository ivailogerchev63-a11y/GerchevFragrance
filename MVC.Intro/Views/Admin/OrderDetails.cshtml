@model Order
@{
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
    ViewData["Title"] = "Поръчка " + Model.OrderNumber;
    ViewData["PageTitle"] = "Поръчка " + Model.OrderNumber;
    var statuses = ViewBag.OrderStatuses as string[];
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <a asp-action="Orders" class="btn-admin-outline"><i class="bi bi-arrow-left me-1"></i>Назад</a>
    <div>
        @{
            var bc = Model.Status switch {
                "Потвърдена" => "badge-confirmed",
                "Обработва се" => "badge-processing",
                "Изпратена" => "badge-shipped",
                "Доставена" => "badge-delivered",
                _ => "badge-cancelled"
            };
        }
        <span class="badge-admin @bc" style="font-size:0.8rem;padding:8px 16px;">@Model.Status</span>
    </div>
</div>

<div class="row g-3">
    <!-- Order Items -->
    <div class="col-lg-8">
        <div class="admin-section mb-3">
            <div class="admin-section-header"><h5><i class="bi bi-bag me-2"></i>Поръчани продукти</h5></div>
            <div class="table-responsive">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>Снимка</th>
                            <th>Продукт</th>
                            <th>Размер</th>
                            <th>Ед. цена</th>
                            <th>Брой</th>
                            <th>Общо</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                                    {
                                        <img src="@item.ImageUrl" alt="@item.ProductName" style="width:45px;height:45px;object-fit:cover;border-radius:2px;" />
                                    }
                                </td>
                                <td>
                                    <div style="font-weight:600;font-size:0.85rem;">@item.ProductName</div>
                                    @if (!string.IsNullOrEmpty(item.ProductBrand))
                                    {
                                        <div style="font-size:0.75rem;color:var(--gold);">@item.ProductBrand</div>
                                    }
                                </td>
                                <td style="font-size:0.82rem;color:var(--text-muted);">@(item.SelectedSize ?? "—")</td>
                                <td style="color:var(--gold);">@item.UnitPrice.ToString("F2") €</td>
                                <td>×@item.Quantity</td>
                                <td style="color:var(--gold);font-weight:600;">@item.LineTotal.ToString("F2") €</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Price summary -->
            <div style="padding:16px 20px;border-top:1px solid var(--dark-border);">
                <div class="d-flex justify-content-end">
                    <table style="font-size:0.85rem;min-width:260px;">
                        <tr>
                            <td style="color:var(--text-muted);padding:4px 0;">Стоки:</td>
                            <td style="text-align:right;padding:4px 0 4px 24px;">@Model.Subtotal.ToString("F2") €</td>
                        </tr>
                        @if (Model.DiscountAmount > 0)
                        {
                            <tr>
                                <td style="color:var(--text-muted);">Отстъпка (@Model.AppliedCouponCode):</td>
                                <td style="text-align:right;color:#48bb78;">−@Model.DiscountAmount.ToString("F2") €</td>
                            </tr>
                        }
                        <tr>
                            <td style="color:var(--text-muted);">Доставка:</td>
                            <td style="text-align:right;">@(Model.ShippingFee == 0 ? "БЕЗПЛАТНА" : Model.ShippingFee.ToString("F2") + " €")</td>
                        </tr>
                        <tr>
                            <td style="color:var(--gold);font-weight:700;padding-top:10px;border-top:1px solid var(--dark-border);">ОБЩО:</td>
                            <td style="text-align:right;color:var(--gold);font-weight:700;padding-top:10px;border-top:1px solid var(--dark-border);font-size:1rem;">@Model.TotalAmount.ToString("F2") €</td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>

        <!-- Change Status -->
        <div class="admin-section">
            <div class="admin-section-header"><h5><i class="bi bi-arrow-repeat me-2"></i>Промяна на статус</h5></div>
            <div class="admin-section-body">
                <form method="post" asp-action="UpdateOrderStatus" class="d-flex gap-2 align-items-end flex-wrap">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="OrderId" value="@Model.Id" />
                    <div>
                        <label class="form-label-gold">Нов статус</label>
                        <select name="NewStatus" class="form-select-dark" style="min-width:200px;">
                            @foreach (var s in statuses ?? Array.Empty<string>())
                            {
                                if (Model.Status == s) { <option value="@s" selected>@s</option> }
                                else { <option value="@s">@s</option> }
                            }
                        </select>
                    </div>
                    <button type="submit" class="btn-admin-gold">Обновяване</button>
                </form>
            </div>
        </div>
    </div>

    <!-- Customer & Delivery Info -->
    <div class="col-lg-4">
        <div class="admin-section mb-3">
            <div class="admin-section-header"><h5><i class="bi bi-person me-2"></i>Данни на клиента</h5></div>
            <div class="admin-section-body">
                <div class="mb-2"><span class="form-label-gold">Имена:</span><div>@Model.CustomerName</div></div>
                <div class="mb-2"><span class="form-label-gold">Имейл:</span><div><a href="mailto:@Model.CustomerEmail" style="color:var(--gold);">@Model.CustomerEmail</a></div></div>
                <div class="mb-2"><span class="form-label-gold">Телефон:</span><div>@Model.CustomerPhone</div></div>
            </div>
        </div>

        <div class="admin-section mb-3">
            <div class="admin-section-header"><h5><i class="bi bi-geo-alt me-2"></i>Адрес за доставка</h5></div>
            <div class="admin-section-body">
                <div class="mb-2"><span class="form-label-gold">Адрес:</span><div>@Model.ShippingAddress</div></div>
                <div class="mb-2"><span class="form-label-gold">Град:</span><div>@Model.City @Model.PostalCode</div></div>
                @if (!string.IsNullOrEmpty(Model.Notes))
                {
                    <div><span class="form-label-gold">Бележки:</span><div style="font-style:italic;color:var(--text-muted);">@Model.Notes</div></div>
                }
            </div>
        </div>

        <div class="admin-section">
            <div class="admin-section-header"><h5><i class="bi bi-info-circle me-2"></i>Информация за поръчката</h5></div>
            <div class="admin-section-body">
                <div class="mb-2"><span class="form-label-gold">Номер:</span><div style="color:var(--gold);font-weight:700;">@Model.OrderNumber</div></div>
                <div class="mb-2"><span class="form-label-gold">Дата:</span><div>@Model.OrderDate.ToString("dd.MM.yyyy HH:mm") UTC</div></div>
                <div class="mb-2"><span class="form-label-gold">Начин на плащане:</span><div>@Model.PaymentMethod</div></div>
                <div><span class="form-label-gold">Имейл изпратен:</span><div>@(Model.ConfirmationEmailSent ? "Да" : "Не")</div></div>
            </div>
        </div>
    </div>
</div>
