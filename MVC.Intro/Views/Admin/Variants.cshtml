@model AdminVariantEditViewModel
@{
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
    ViewData["Title"] = "Варианти";
    ViewData["PageTitle"] = "Варианти: " + Model.ProductName;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <a asp-action="Products" class="btn-admin-outline"><i class="bi bi-arrow-left me-1"></i>Назад към продукти</a>
    <a asp-action="EditProduct" asp-route-id="@Model.ProductId" class="btn-admin-outline">
        <i class="bi bi-pencil me-1"></i>Редактирай продукта
    </a>
</div>

<div class="row g-3">
    <!-- Existing variants -->
    <div class="col-lg-7">
        <div class="admin-section">
            <div class="admin-section-header">
                <h5><i class="bi bi-layers me-2"></i>Съществуващи варианти (@Model.ExistingVariants.Count)</h5>
            </div>
            @if (Model.ExistingVariants.Any())
            {
                <div class="table-responsive">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>Обем</th>
                                <th>Цена</th>
                                <th>Оригинална цена</th>
                                <th>Запас</th>
                                <th>Наличен</th>
                                <th>Действия</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var v in Model.ExistingVariants)
                            {
                                <tr>
                                    <td><strong style="color:var(--gold);">@v.SizeMl ml</strong></td>
                                    <td>@v.Price.ToString("F2") €</td>
                                    <td>
                                        @if (v.OriginalPrice.HasValue)
                                        {
                                            <span style="text-decoration:line-through;color:#666;">@v.OriginalPrice.Value.ToString("F2") €</span>
                                        }
                                        else { <span style="color:var(--text-muted);">—</span> }
                                    </td>
                                    <td>
                                        <span class="@(v.StockQuantity <= 0 ? "badge-admin badge-cancelled" : v.StockQuantity <= 3 ? "badge-admin badge-processing" : "badge-admin badge-confirmed")">
                                            @v.StockQuantity
                                        </span>
                                    </td>
                                    <td>
                                        @if (v.IsAvailable)
                                        {
                                            <span class="badge-admin badge-confirmed">Да</span>
                                        }
                                        else
                                        {
                                            <span class="badge-admin badge-cancelled">Не</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="d-flex gap-1">
                                            <a asp-action="EditVariant" asp-route-id="@v.Id" class="btn-admin-outline btn-admin-sm"><i class="bi bi-pencil"></i></a>
                                            <form method="post" asp-action="DeleteVariant" asp-route-id="@v.Id" asp-route-productId="@Model.ProductId"
                                                  style="display:inline;" onsubmit="return confirm('Изтриване на варианта?')">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn-admin-danger btn-admin-sm"><i class="bi bi-trash3"></i></button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="admin-section-body" style="color:var(--text-muted);">Няма добавени варианти. Добавете поне един.</div>
            }
        </div>
    </div>

    <!-- Add new variant -->
    <div class="col-lg-5">
        <div class="admin-section">
            <div class="admin-section-header"><h5><i class="bi bi-plus-circle me-2"></i>Добавяне на вариант</h5></div>
            <div class="admin-section-body">
                <form method="post" asp-action="AddVariant">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ProductId" />

                    <div class="mb-3">
                        <label class="form-label-gold">Обем (ml) *</label>
                        <input asp-for="SizeMl" type="number" class="form-control-dark w-100" placeholder="напр. 50, 75, 100" />
                        <span asp-validation-for="SizeMl" class="text-danger" style="font-size:0.78rem;"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label-gold">Цена (EUR) *</label>
                        <input asp-for="Price" type="number" step="0.01" class="form-control-dark w-100" />
                        <span asp-validation-for="Price" class="text-danger" style="font-size:0.78rem;"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label-gold">Оригинална цена (за задраскване)</label>
                        <input asp-for="OriginalPrice" type="number" step="0.01" class="form-control-dark w-100" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label-gold">Наличност (бр.)</label>
                        <input asp-for="StockQuantity" type="number" class="form-control-dark w-100" />
                    </div>
                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" asp-for="IsAvailable" id="isAvailable" checked />
                        <label class="form-check-label" for="isAvailable" style="color:var(--text-light);">Наличен</label>
                    </div>

                    <button type="submit" class="btn-admin-gold w-100">
                        <i class="bi bi-plus-circle me-1"></i>Добавяне
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
