@{
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
    ViewData["Title"] = "Лог на действията";
    ViewData["PageTitle"] = "Лог на действията";
    var logs = ViewBag.Logs as List<MVC.Intro.Models.AdminAuditLog> ?? new();
    int page = ViewBag.Page ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalCount = ViewBag.TotalCount ?? 0;
}

<div class="admin-section">
    <div class="admin-section-header">
        <h5><i class="bi bi-journal-text me-2"></i>Лог на администраторски действия (@totalCount)</h5>
    </div>
    <div class="table-responsive">
        <table class="admin-table">
            <thead><tr><th>Дата & Час</th><th>Администратор</th><th>Действие</th><th>Описание</th><th>Обект</th></tr></thead>
            <tbody>
                @foreach (var l in logs)
                {
                    <tr>
                        <td style="font-size:0.78rem;color:var(--text-muted);white-space:nowrap;">@l.CreatedAt.ToString("dd.MM.yyyy HH:mm:ss")</td>
                        <td style="font-size:0.8rem;">@l.AdminEmail</td>
                        <td><span class="badge-admin badge-confirmed" style="font-size:0.68rem;">@l.Action</span></td>
                        <td style="font-size:0.82rem;">@l.Description</td>
                        <td style="font-size:0.75rem;color:var(--text-muted);">@l.EntityType @(l.EntityId?.Length > 8 ? l.EntityId[..8] + "…" : l.EntityId)</td>
                    </tr>
                }
                @if (!logs.Any())
                {
                    <tr><td colspan="5" style="text-align:center;color:var(--text-muted);padding:30px;">Няма записи.</td></tr>
                }
            </tbody>
        </table>
    </div>

    @if (totalPages > 1)
    {
        <div class="admin-section-body d-flex justify-content-center">
            <div class="admin-pagination">
                @if (page > 1) { <a asp-action="AuditLog" asp-route-page="@(page-1)"><i class="bi bi-chevron-left"></i></a> }
                @for (int i = Math.Max(1, page-2); i <= Math.Min(totalPages, page+2); i++)
                {
                    @if (i == page) { <span class="active">@i</span> }
                    else { <a asp-action="AuditLog" asp-route-page="@i">@i</a> }
                }
                @if (page < totalPages) { <a asp-action="AuditLog" asp-route-page="@(page+1)"><i class="bi bi-chevron-right"></i></a> }
            </div>
        </div>
    }
</div>
