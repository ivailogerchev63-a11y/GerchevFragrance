@model AdminDiscountEditViewModel
@{
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
    ViewData["Title"] = "Редактиране на код";
    ViewData["PageTitle"] = "Редактиране: " + Model.Code;
}

<div class="mb-4"><a asp-action="Discounts" class="btn-admin-outline"><i class="bi bi-arrow-left me-1"></i>Назад</a></div>

<div class="row">
    <div class="col-lg-6">
        <div class="admin-section">
            <div class="admin-section-header"><h5>Редактиране на код</h5></div>
            <div class="admin-section-body">
                <form method="post" asp-action="EditDiscount">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <div class="mb-3">
                        <label class="form-label-gold">Код *</label>
                        <input asp-for="Code" class="form-control-dark w-100" style="text-transform:uppercase;" />
                        <span asp-validation-for="Code" class="text-danger" style="font-size:0.78rem;"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label-gold">Имейл *</label>
                        <input asp-for="Email" class="form-control-dark w-100" type="email" />
                        <span asp-validation-for="Email" class="text-danger" style="font-size:0.78rem;"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label-gold">Отстъпка (%)</label>
                        <input asp-for="DiscountPercentage" type="number" step="1" min="1" max="100" class="form-control-dark w-100" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label-gold">Изтичане</label>
                        <input asp-for="ExpiresAt" type="datetime-local" class="form-control-dark w-100" />
                    </div>
                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" asp-for="IsUsed" id="isUsed" />
                        <label class="form-check-label" for="isUsed" style="color:var(--text-light);">Маркиран като използван</label>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn-admin-gold"><i class="bi bi-check2 me-1"></i>Запази</button>
                        <a asp-action="Discounts" class="btn-admin-outline">Отказ</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
