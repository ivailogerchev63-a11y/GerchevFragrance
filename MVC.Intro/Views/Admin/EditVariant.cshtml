@model AdminVariantEditViewModel
@{
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
    ViewData["Title"] = "Редактиране на вариант";
    ViewData["PageTitle"] = "Редактиране на вариант — " + Model.ProductName;
}

<div class="mb-4">
    <a asp-action="Variants" asp-route-productId="@Model.ProductId" class="btn-admin-outline"><i class="bi bi-arrow-left me-1"></i>Назад</a>
</div>

<div class="row">
    <div class="col-lg-6">
        <div class="admin-section">
            <div class="admin-section-header"><h5>Редактиране на вариант</h5></div>
            <div class="admin-section-body">
                <form method="post" asp-action="EditVariant">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="ProductId" />

                    <div class="mb-3">
                        <label class="form-label-gold">Обем (ml) *</label>
                        <input asp-for="SizeMl" type="number" class="form-control-dark w-100" />
                        <span asp-validation-for="SizeMl" class="text-danger" style="font-size:0.78rem;"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label-gold">Цена (EUR) *</label>
                        <input asp-for="Price" type="number" step="0.01" class="form-control-dark w-100" />
                        <span asp-validation-for="Price" class="text-danger" style="font-size:0.78rem;"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label-gold">Оригинална цена</label>
                        <input asp-for="OriginalPrice" type="number" step="0.01" class="form-control-dark w-100" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label-gold">Наличност (бр.)</label>
                        <input asp-for="StockQuantity" type="number" class="form-control-dark w-100" />
                    </div>
                    <div class="form-check form-switch mb-4">
                        <input class="form-check-input" type="checkbox" asp-for="IsAvailable" id="isAvailable" />
                        <label class="form-check-label" for="isAvailable" style="color:var(--text-light);">Наличен</label>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn-admin-gold"><i class="bi bi-check2 me-1"></i>Запази</button>
                        <a asp-action="Variants" asp-route-productId="@Model.ProductId" class="btn-admin-outline">Отказ</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
