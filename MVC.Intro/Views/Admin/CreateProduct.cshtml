@model AdminProductEditViewModel
@{
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
    ViewData["Title"] = "Нов продукт";
    ViewData["PageTitle"] = "Добавяне на продукт";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <a asp-action="Products" class="btn-admin-outline"><i class="bi bi-arrow-left me-1"></i>Назад</a>
</div>

<form method="post" enctype="multipart/form-data" asp-action="CreateProduct">
    @Html.AntiForgeryToken()
    <div class="row g-3">
        <!-- Left column: core info -->
        <div class="col-lg-8">
            <div class="admin-section">
                <div class="admin-section-header"><h5>Основна информация</h5></div>
                <div class="admin-section-body">
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label-gold">Наименование *</label>
                            <input asp-for="Name" class="form-control-dark w-100" />
                            <span asp-validation-for="Name" class="text-danger" style="font-size:0.78rem;"></span>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label-gold">Марка</label>
                            <input asp-for="Brand" class="form-control-dark w-100" />
                        </div>
                        <div class="col-12">
                            <label class="form-label-gold">Описание</label>
                            <textarea asp-for="Description" class="form-control-dark w-100" rows="4"></textarea>
                        </div>
                        <div class="col-12">
                            <label class="form-label-gold">Нотки (Връхни | Сърце | База)</label>
                            <input asp-for="Notes" class="form-control-dark w-100" placeholder="Връхни: … | Сърце: … | База: …" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label-gold">Ароматно семейство</label>
                            <input asp-for="FragranceFamily" class="form-control-dark w-100" placeholder="напр. Ориенталски Фужер" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label-gold">Концентрация</label>
                            <select asp-for="Concentration" class="form-select-dark w-100">
                                <option value="">— изберете —</option>
                                @foreach (var c in new[] { "EDT", "EDP", "Parfum", "Extrait", "Elixir", "EDC", "Oil" })
                                {
                                    <option value="@c">@c</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <div class="admin-section">
                <div class="admin-section-header"><h5>Цени и наличност</h5></div>
                <div class="admin-section-body">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label-gold">Основна цена (EUR) *</label>
                            <input asp-for="Price" type="number" step="0.01" class="form-control-dark w-100" />
                            <span asp-validation-for="Price" class="text-danger" style="font-size:0.78rem;"></span>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label-gold">Оригинална цена (за задраскване)</label>
                            <input asp-for="OriginalPrice" type="number" step="0.01" class="form-control-dark w-100" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label-gold">Наличност (бр.)</label>
                            <input asp-for="StockQuantity" type="number" class="form-control-dark w-100" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label-gold">Категория</label>
                            <select asp-for="Category" class="form-select-dark w-100">
                                @foreach (var cat in new[] { "Men", "Women", "Unisex", "Luxury Fragrances" })
                                {
                                    <option value="@cat">@cat</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label-gold">Размер по подразбиране</label>
                            <input asp-for="Size" class="form-control-dark w-100" placeholder="напр. 75 ml" />
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right column: image + settings -->
        <div class="col-lg-4">
            <div class="admin-section mb-3">
                <div class="admin-section-header"><h5>Изображение</h5></div>
                <div class="admin-section-body">
                    <label class="form-label-gold">Качи файл (JPG, PNG, WebP — до 5 MB)</label>
                    <input type="file" asp-for="ImageFile" class="form-control-dark w-100 mb-2" accept="image/*" id="imgFileInput" onchange="previewImage(this)" />
                    <img id="imgPreview" src="" alt="Преглед" class="img-preview w-100 mt-2" style="display:none;max-height:200px;object-fit:contain;" />
                    <span asp-validation-for="ImageFile" class="text-danger" style="font-size:0.78rem;"></span>
                    <hr class="divider-gold" />
                    <label class="form-label-gold">или URL на изображение</label>
                    <input asp-for="ImageUrl" class="form-control-dark w-100" placeholder="/images/product.jpg" />
                </div>
            </div>

            <div class="admin-section">
                <div class="admin-section-header"><h5>Настройки</h5></div>
                <div class="admin-section-body">
                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" asp-for="IsBestseller" id="isBestseller" />
                        <label class="form-check-label" for="isBestseller" style="color:var(--text-light);">Бестселър</label>
                    </div>
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" asp-for="IsFeatured" id="isFeatured" />
                        <label class="form-check-label" for="isFeatured" style="color:var(--text-light);">Препоръчан (Hero продукт)</label>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex gap-3 mt-3">
        <button type="submit" class="btn-admin-gold"><i class="bi bi-check2 me-1"></i>Запази продукта</button>
        <a asp-action="Products" class="btn-admin-outline">Отказ</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function previewImage(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function (e) {
                    var preview = document.getElementById('imgPreview');
                    preview.src = e.target.result;
                    preview.style.display = 'block';
                };
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
}
