@model AdminDiscountListViewModel
@{
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
    ViewData["Title"] = "Отстъпки";
    ViewData["PageTitle"] = "Управление на отстъпки";
    var now = DateTime.UtcNow;
}

<div class="d-flex flex-wrap align-items-end justify-content-between gap-3 mb-4">
    <form method="get" class="d-flex gap-2">
        <input type="text" name="search" value="@Model.Search" class="form-control-dark" placeholder="Код или имейл…" style="width:260px;" />
        <button type="submit" class="btn-admin-gold">Търсене</button>
        @if (!string.IsNullOrEmpty(Model.Search)) { <a asp-action="Discounts" class="btn-admin-outline">Изчисти</a> }
    </form>
    <a asp-action="CreateDiscount" class="btn-admin-gold"><i class="bi bi-plus-circle me-1"></i>Нов код</a>
</div>

<div class="admin-section">
    <div class="admin-section-header"><h5>Кодове за отстъпка (@Model.TotalCount)</h5></div>
    <div class="table-responsive">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Код</th>
                    <th>Имейл</th>
                    <th>Отстъпка</th>
                    <th>Изтичане</th>
                    <th>Статус</th>
                    <th>Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model.Coupons)
                {
                    var statusBadge = c.IsUsed ? "badge-cancelled" : c.ExpiresAt <= now ? "badge-processing" : "badge-confirmed";
                    var statusText = c.IsUsed ? "Използван" : c.ExpiresAt <= now ? "Изтекъл" : "Активен";
                    <tr>
                        <td><strong style="color:var(--gold);letter-spacing:1px;">@c.Code</strong></td>
                        <td style="font-size:0.82rem;color:var(--text-muted);">@c.Email</td>
                        <td><span class="badge-admin badge-confirmed">@c.DiscountPercentage.ToString("F0")%</span></td>
                        <td style="font-size:0.8rem;@(c.ExpiresAt <= now && !c.IsUsed ? "color:#e53e3e;" : "color:var(--text-muted);" )">@c.ExpiresAt.ToString("dd.MM.yyyy")</td>
                        <td><span class="badge-admin @statusBadge">@statusText</span></td>
                        <td>
                            <div class="d-flex gap-1">
                                <a asp-action="EditDiscount" asp-route-id="@c.Id" class="btn-admin-outline btn-admin-sm"><i class="bi bi-pencil"></i></a>
                                <form method="post" asp-action="DeleteDiscount" asp-route-id="@c.Id" style="display:inline;"
                                      onsubmit="return confirm('Изтриване на кода?')">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn-admin-danger btn-admin-sm"><i class="bi bi-trash3"></i></button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Coupons.Any())
                {
                    <tr><td colspan="6" style="text-align:center;color:var(--text-muted);padding:30px;">Няма намерени кодове.</td></tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPages > 1)
    {
        <div class="admin-section-body d-flex justify-content-center">
            <div class="admin-pagination">
                @if (Model.Page > 1) { <a asp-action="Discounts" asp-route-page="@(Model.Page-1)" asp-route-search="@Model.Search"><i class="bi bi-chevron-left"></i></a> }
                @for (int i = Math.Max(1, Model.Page-2); i <= Math.Min(Model.TotalPages, Model.Page+2); i++)
                {
                    @if (i == Model.Page) { <span class="active">@i</span> }
                    else { <a asp-action="Discounts" asp-route-page="@i" asp-route-search="@Model.Search">@i</a> }
                }
                @if (Model.Page < Model.TotalPages) { <a asp-action="Discounts" asp-route-page="@(Model.Page+1)" asp-route-search="@Model.Search"><i class="bi bi-chevron-right"></i></a> }
            </div>
        </div>
    }
</div>
