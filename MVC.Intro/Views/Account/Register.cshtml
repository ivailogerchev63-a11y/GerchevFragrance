@model MVC.Intro.Models.RegisterViewModel
@{
    ViewData["Title"] = "Регистрация";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section style="min-height:80vh; display:flex; align-items:center; padding:60px 0;
    background: radial-gradient(ellipse at 50% 0%, #1a1508 0%, #0d0d0d 70%);">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-5">
                <div class="text-center mb-5">
                    <p style="color:#C9A84C; letter-spacing:5px; text-transform:uppercase; font-size:0.7rem;">
                        GerchevFragrance
                    </p>
                    <h2 style="font-family:'Playfair Display',serif; color:#f0ead6; font-size:2rem;">
                        Създайте Акаунт
                    </h2>
                    <hr class="divider-gold" style="width:60px; margin:16px auto;">
                </div>

                <div asp-validation-summary="ModelOnly" style="color:#e07070; font-size:0.85rem; margin-bottom:16px;"></div>

                <form asp-action="Register" method="post" class="form-luxury">
                    @Html.AntiForgeryToken()

                    <div class="row g-3 mb-4">
                        <div class="col-6">
                            <label asp-for="FirstName"></label>
                            <input asp-for="FirstName" class="form-control" placeholder="Иван" />
                            <span asp-validation-for="FirstName" style="color:#e07070; font-size:0.78rem;"></span>
                        </div>
                        <div class="col-6">
                            <label asp-for="LastName"></label>
                            <input asp-for="LastName" class="form-control" placeholder="Иванов" />
                            <span asp-validation-for="LastName" style="color:#e07070; font-size:0.78rem;"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Email"></label>
                        <input asp-for="Email" class="form-control" placeholder="вашият@имейл.com" autocomplete="email" />
                        <span asp-validation-for="Email" style="color:#e07070; font-size:0.78rem;"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Password"></label>
                        <input asp-for="Password" class="form-control" placeholder="••••••••" autocomplete="new-password" />
                        <span asp-validation-for="Password" style="color:#e07070; font-size:0.78rem;"></span>
                    </div>

                    <div class="mb-5">
                        <label asp-for="ConfirmPassword"></label>
                        <input asp-for="ConfirmPassword" class="form-control" placeholder="••••••••" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmPassword" style="color:#e07070; font-size:0.78rem;"></span>
                    </div>

                    <button type="submit" class="btn btn-gold w-100" style="padding:13px;">
                        Регистрирай се
                    </button>
                </form>

                <div class="text-center mt-4">
                    <p style="color:#666; font-size:0.82rem;">
                        Вече имате акаунт?
                        <a asp-action="Login" style="color:#C9A84C; text-decoration:none;">Влезте тук</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
