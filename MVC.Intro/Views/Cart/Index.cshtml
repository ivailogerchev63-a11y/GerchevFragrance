@model MVC.Intro.Models.CartViewModel
@{
    ViewData["Title"] = "Вашата Количка";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section style="padding: 60px 0 100px; min-height: 75vh;">
    <div class="container">
        <div class="text-center mb-5">
            <p style="color:var(--gold); letter-spacing:4px; text-transform:uppercase; font-size:0.75rem;">
                — Селекция —
            </p>
            <h1 style="font-family:'Playfair Display',serif; font-size:2.8rem; color:#f0ead6;">
                Вашата Количка
            </h1>
            <hr class="divider-gold" style="width:80px; margin:20px auto;">
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show text-center" role="alert" 
                 style="background:rgba(40,167,69,0.2); border:1px solid #28a745; color:#85e89d;">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show text-center" role="alert"
                 style="background:rgba(220,53,69,0.2); border:1px solid #dc3545; color:#ff8585;">
                @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (!Model.Items.Any())
        {
            <div class="text-center py-5" style="background:var(--dark2); border:1px solid #222; padding:60px 20px;">
                <div style="font-size:3rem; color:var(--gold); margin-bottom:20px;">🛍️</div>
                <h3 style="color:#eee; font-family:'Playfair Display',serif;">Количката ви е празна</h3>
                <p style="color:#888; max-width:400px; margin:15px auto 30px;">
                    Разгледайте нашата селекция от световно признати дизайнерски и нишови аромати.
                </p>
                <a asp-controller="Product" asp-action="Index" class="btn btn-gold">
                    Разгледай Колекцията
                </a>
            </div>
        }
        else
        {
            <div class="row g-5">
                <!-- Cart Items List -->
                <div class="col-lg-8">
                    <div style="background:var(--dark2); border:1px solid #262626; padding:24px;">
                        @foreach (var item in Model.Items)
                        {
                            <div class="d-flex align-items-center justify-content-between py-3 border-bottom border-secondary border-opacity-25 flex-wrap gap-3">
                                <div class="d-flex align-items-center gap-3">
                                    <img src="@item.ImageUrl" alt="@item.Name" 
                                         style="width:80px; height:80px; object-fit:cover; border:1px solid #333;"
                                         onerror="this.src='/images/images.jpg'">
                                    <div>
                                        <div style="color:var(--gold); font-size:0.75rem; letter-spacing:2px; text-transform:uppercase;">
                                            @item.Brand
                                        </div>
                                        <h5 style="color:#eee; font-family:'Playfair Display',serif; margin:3px 0 5px; font-size:1.1rem;">
                                            @item.Name
                                        </h5>
                                        <div style="color:#888; font-size:0.8rem;">
                                            @item.Concentration · @item.Size
                                        </div>
                                    </div>
                                </div>

                                <div class="d-flex align-items-center gap-4">
                                    <div class="d-flex align-items-center" style="border:1px solid #333; background:var(--dark);">
                                        <form asp-action="UpdateQuantity" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.ProductId" />
                                            <input type="hidden" name="quantity" value="@(item.Quantity - 1)" />
                                            <button type="submit" class="btn btn-sm text-light px-2" style="background:none; border:none;">−</button>
                                        </form>
                                        <span class="px-2" style="color:var(--gold); font-weight:600; min-width:30px; text-align:center;">
                                            @item.Quantity
                                        </span>
                                        <form asp-action="UpdateQuantity" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.ProductId" />
                                            <input type="hidden" name="quantity" value="@(item.Quantity + 1)" />
                                            <button type="submit" class="btn btn-sm text-light px-2" style="background:none; border:none;">+</button>
                                        </form>
                                    </div>

                                    <div style="min-width:100px; text-align:right;">
                                        <span style="color:#fff; font-family:'Playfair Display',serif; font-size:1.15rem;">
                                            @CurrencyHelper.FormatEuro(item.Subtotal)
                                        </span>
                                    </div>

                                    <form asp-action="Remove" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.ProductId" />
                                        <button type="submit" class="btn btn-sm text-danger" title="Премахни" style="background:none; border:none;">
                                            ✕
                                        </button>
                                    </form>
                                </div>
                            </div>
                        }

                        <div class="d-flex justify-content-between align-items-center mt-4">
                            <a asp-controller="Product" asp-action="Index" class="btn btn-outline-gold btn-sm">
                                ← Продължи пазаруването
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Order Summary & Coupon -->
                <div class="col-lg-4">
                    <div style="background:var(--dark2); border:1px solid #262626; padding:30px;">
                        <h4 style="font-family:'Playfair Display',serif; color:#f0ead6; margin-bottom:20px;">
                            Обобщение на поръчката
                        </h4>

                        <div class="d-flex justify-content-between py-2 border-bottom border-secondary border-opacity-25" style="color:#aaa; font-size:0.9rem;">
                            <span>Междинна сума</span>
                            <span style="color:#eee;">@CurrencyHelper.FormatEuro(Model.Subtotal)</span>
                        </div>

                        <!-- Coupon Form -->
                        <div class="py-3 border-bottom border-secondary border-opacity-25">
                            @if (!string.IsNullOrEmpty(Model.AppliedCouponCode))
                            {
                                <div class="d-flex justify-content-between align-items-center bg-dark p-2 border border-warning" style="font-size:0.85rem;">
                                    <div>
                                        <span class="badge bg-warning text-dark me-1">@Model.AppliedCouponCode</span>
                                        <span style="color:#85e89d;">-@Model.DiscountPercentage.ToString("F0")% отстъпка</span>
                                    </div>
                                    <form asp-action="RemoveCoupon" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm text-secondary p-0" title="Премахни код">✕</button>
                                    </form>
                                </div>
                                <div class="d-flex justify-content-between mt-2" style="color:#85e89d; font-size:0.9rem;">
                                    <span>Отстъпка (10%)</span>
                                    <span>-@CurrencyHelper.FormatEuro(Model.DiscountAmount)</span>
                                </div>
                            }
                            else
                            {
                                <label style="font-size:0.75rem; letter-spacing:1px; color:#aaa; text-transform:uppercase; margin-bottom:8px; display:block;">
                                    Код за отстъпка
                                </label>
                                <form asp-action="ApplyCoupon" method="post" class="d-flex gap-2">
                                    @Html.AntiForgeryToken()
                                    <input type="text" name="code" class="form-control form-control-sm" 
                                           placeholder="напр. GERCHEV10" style="background:var(--dark); border-color:#444; color:#fff;" />
                                    <button type="submit" class="btn btn-outline-gold btn-sm" style="white-space:nowrap;">
                                        Приложи
                                    </button>
                                </form>
                                <small style="color:#888; font-size:0.75rem; display:block; margin-top:6px;">
                                    Имате код GERCHEV10? Въведете го тук за 10% отстъпка.
                                </small>
                            }
                        </div>

                        <div class="d-flex justify-content-between py-2 border-bottom border-secondary border-opacity-25" style="color:#aaa; font-size:0.9rem;">
                            <span>Доставка</span>
                            <span style="color:#85e89d;">@(Model.ShippingFee == 0 ? "Безплатна" : CurrencyHelper.FormatEuro(Model.ShippingFee))</span>
                        </div>

                        <div class="d-flex justify-content-between py-3 my-2" style="font-size:1.3rem;">
                            <span style="color:#f0ead6; font-family:'Playfair Display',serif;">Общо</span>
                            <span style="color:var(--gold); font-family:'Playfair Display',serif; font-weight:700;">
                                @CurrencyHelper.FormatEuro(Model.Total)
                            </span>
                        </div>

                        <a asp-controller="Checkout" asp-action="Index" class="btn btn-gold w-100 py-3 mt-3" style="letter-spacing:2px;">
                            Продължи към плащане →
                        </a>

                        <div class="text-center mt-3" style="color:#777; font-size:0.75rem;">
                            🔒 Защитено 256-битово криптирано плащане
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</section>
