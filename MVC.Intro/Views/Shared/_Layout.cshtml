<!DOCTYPE html>
<html lang="bg">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — GerchevFragrance</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=Lato:wght@300;400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        :root {
            --gold: #C9A84C;
            --gold-light: #e8c96a;
            --dark: #0d0d0d;
            --dark2: #1a1a1a;
            --dark3: #262626;
        }
        * { box-sizing: border-box; }
        body {
            background-color: var(--dark);
            color: #e8e0d0;
            font-family: 'Lato', sans-serif;
            font-weight: 300;
        }
        h1, h2, h3, h4, h5, .brand-font {
            font-family: 'Playfair Display', serif;
        }
        /* NAVBAR */
        .navbar-luxury {
            background: rgba(13,13,13,0.97);
            border-bottom: 1px solid #2a2a2a;
            padding: 18px 0;
            backdrop-filter: blur(10px);
        }
        .navbar-brand-luxury {
            font-family: 'Playfair Display', serif;
            font-size: 1.6rem;
            color: var(--gold) !important;
            letter-spacing: 3px;
            text-transform: uppercase;
            text-decoration: none;
        }
        .navbar-luxury .nav-link {
            color: #ccc !important;
            font-family: 'Lato', sans-serif;
            font-weight: 400;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            font-size: 0.78rem;
            margin: 0 10px;
            transition: color 0.3s;
        }
        .navbar-luxury .nav-link:hover { color: var(--gold) !important; }
        .btn-gold {
            background: linear-gradient(135deg, var(--gold), #a8873a);
            color: #0d0d0d;
            border: none;
            font-family: 'Lato', sans-serif;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
            font-size: 0.75rem;
            padding: 10px 28px;
            transition: all 0.3s;
        }
        .btn-gold:hover {
            background: linear-gradient(135deg, var(--gold-light), var(--gold));
            color: #0d0d0d;
            transform: translateY(-1px);
            box-shadow: 0 4px 20px rgba(201,168,76,0.3);
        }
        .btn-outline-gold {
            border: 1px solid var(--gold);
            color: var(--gold);
            background: transparent;
            font-family: 'Lato', sans-serif;
            font-weight: 400;
            letter-spacing: 2px;
            text-transform: uppercase;
            font-size: 0.75rem;
            padding: 9px 26px;
            transition: all 0.3s;
        }
        .btn-outline-gold:hover {
            background: var(--gold);
            color: #0d0d0d;
        }
        /* CARDS */
        .product-card {
            background: var(--dark2);
            border: 1px solid #2a2a2a;
            transition: all 0.4s;
            overflow: hidden;
        }
        .product-card:hover {
            border-color: var(--gold);
            transform: translateY(-6px);
            box-shadow: 0 12px 40px rgba(201,168,76,0.15);
        }
        .product-card img {
            width: 100%;
            height: 280px;
            object-fit: cover;
            transition: transform 0.5s;
        }
        .product-card:hover img { transform: scale(1.04); }
        .product-card-body { padding: 22px; }
        .product-brand {
            color: var(--gold);
            font-size: 0.7rem;
            letter-spacing: 3px;
            text-transform: uppercase;
            margin-bottom: 6px;
        }
        .product-name {
            font-family: 'Playfair Display', serif;
            font-size: 1.15rem;
            color: #f0ead6;
            margin-bottom: 6px;
        }
        .product-meta {
            color: #888;
            font-size: 0.78rem;
            margin-bottom: 12px;
        }
        .product-price {
            color: var(--gold);
            font-size: 1.2rem;
            font-family: 'Playfair Display', serif;
        }
        /* FOOTER */
        footer {
            background: var(--dark2);
            border-top: 1px solid #2a2a2a;
            padding: 40px 0 20px;
            margin-top: 80px;
        }
        footer .footer-brand {
            font-family: 'Playfair Display', serif;
            color: var(--gold);
            font-size: 1.4rem;
            letter-spacing: 3px;
        }
        footer p { color: #666; font-size: 0.83rem; }
        /* FORMS */
        .form-luxury .form-control {
            background: var(--dark3);
            border: 1px solid #333;
            color: #e8e0d0;
            padding: 12px 16px;
            border-radius: 0;
        }
        .form-luxury .form-control:focus {
            background: var(--dark3);
            border-color: var(--gold);
            color: #fff;
            box-shadow: 0 0 0 2px rgba(201,168,76,0.15);
        }
        .form-luxury label {
            color: #aaa;
            font-size: 0.78rem;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            margin-bottom: 6px;
        }
        .divider-gold {
            border: none;
            height: 1px;
            background: linear-gradient(to right, transparent, var(--gold), transparent);
            margin: 40px 0;
        }
        .badge-concentration {
            background: transparent;
            border: 1px solid var(--gold);
            color: var(--gold);
            font-size: 0.68rem;
            letter-spacing: 2px;
            padding: 3px 10px;
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-luxury sticky-top">
        <div class="container">
            <a class="navbar-brand-luxury" asp-controller="Home" asp-action="Index">
                ✦ GerchevFragrance
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMain"
                    style="border-color:#333; color:#aaa;">
                <span class="navbar-toggler-icon" style="filter:invert(1)"></span>
            </button>
            <div class="collapse navbar-collapse" id="navMain">
                <ul class="navbar-nav mx-auto">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index">Начало</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Product" asp-action="Index">Парфюми</a>
                    </li>
                </ul>
                <div class="d-flex align-items-center gap-2">
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <span style="color:#888; font-size:0.78rem; letter-spacing:1px;">@User.Identity.Name</span>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-gold btn-sm">Изход</button>
                        </form>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" class="btn btn-outline-gold btn-sm">Вход</a>
                        <a asp-controller="Account" asp-action="Register" class="btn btn-gold btn-sm">Регистрация</a>
                    }
                </div>
            </div>
        </div>
    </nav>

    <main>
        @RenderBody()
    </main>

    <footer>
        <div class="container text-center">
            <div class="footer-brand mb-3">✦ GerchevFragrance</div>
            <p>Луксозни парфюми от Maison Gerchev</p>
            <hr class="divider-gold" style="margin: 20px auto; width:200px;">
            <p>&copy; 2026 GerchevFragrance. Всички права запазени.</p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
