@model IEnumerable<MVC.Intro.Models.Product>
@using MVC.Intro.Helpers
@{
    ViewData["Title"] = "Колекция Парфюми";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var currentCat = ViewBag.CurrentCategory as string;
    var searchTerm = ViewBag.SearchTerm as string;
    var currentFilter = ViewBag.CurrentFilter as string;
}

<section style="padding: 60px 0 100px;">
    <div class="container">
        <!-- Heading -->
        <div class="text-center mb-5">
            <p style="color:var(--gold); letter-spacing:4px; text-transform:uppercase; font-size:0.75rem;">
                — Селекция на Gerchev Fragrance —
            </p>
            <h1 style="font-family:var(--font-serif); font-size:clamp(2.4rem, 4vw, 3.2rem); color:#f0ead6;">
                Нашата Колекция
            </h1>
            <hr class="divider-gold" style="width:80px; margin:20px auto;">

            @if (!string.IsNullOrEmpty(searchTerm))
            {
                <p style="color:#aaa; font-size:0.95rem;">
                    Резултати от търсенето за: <strong style="color:var(--gold);">"@searchTerm"</strong>
                    <a asp-action="Index" class="btn btn-sm btn-link text-secondary text-decoration-none ms-2">✕ Изчисти</a>
                </p>
            }
        </div>

        <!-- Filter & Category Pills -->
        <div class="d-flex justify-content-center flex-wrap gap-2 mb-5">
            <a asp-action="Index"
               class="btn btn-sm @(string.IsNullOrEmpty(currentCat) && string.IsNullOrEmpty(currentFilter) ? "btn-gold" : "btn-outline-gold")"
               style="font-size:0.75rem;">
                Всички
            </a>
            <a asp-action="Index" asp-route-category="Men"
               class="btn btn-sm @(currentCat == "Men" ? "btn-gold" : "btn-outline-gold")"
               style="font-size:0.75rem;">
                Мъжки
            </a>
            <a asp-action="Index" asp-route-category="Women"
               class="btn btn-sm @(currentCat == "Women" ? "btn-gold" : "btn-outline-gold")"
               style="font-size:0.75rem;">
                Дамски
            </a>
            <a asp-action="Index" asp-route-category="Unisex"
               class="btn btn-sm @(currentCat == "Unisex" ? "btn-gold" : "btn-outline-gold")"
               style="font-size:0.75rem;">
                Унисекс
            </a>
            <a asp-action="Index" asp-route-category="Luxury Fragrances"
               class="btn btn-sm @(currentCat == "Luxury Fragrances" ? "btn-gold" : "btn-outline-gold")"
               style="font-size:0.75rem;">
                Луксозни &amp; Нишови
            </a>
            <a asp-action="Index" asp-route-filter="bestsellers"
               class="btn btn-sm @(currentFilter == "bestsellers" ? "btn-gold" : "btn-outline-gold")"
               style="font-size:0.75rem;">
                ✦ Бестселъри
            </a>
            <a asp-action="Index" asp-route-filter="offers"
               class="btn btn-sm @(currentFilter == "offers" ? "btn-gold" : "btn-outline-gold")"
               style="font-size:0.75rem;">
                Промоции
            </a>
        </div>

        @if (!Model.Any())
        {
            <div class="text-center py-5" style="background:var(--dark-card); border:1px solid #222; padding:60px 20px;">
                <p style="color:#aaa; font-size:1.1rem; margin-bottom:20px;">Няма намерени парфюми по зададените критерии.</p>
                <a asp-action="Index" class="btn btn-gold">Виж всички парфюми</a>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var product in Model)
                {
                    var hasVariants = product.Variants != null && product.Variants.Any();
                    var availableVariants = hasVariants
                        ? product.Variants.Where(v => v.IsAvailable).OrderBy(v => v.SizeMl).ToList()
                        : new List<MVC.Intro.Models.ProductVariant>();
                    var startPrice = availableVariants.Any() ? availableVariants.Min(v => v.Price) : product.Price;
                    var defaultVariant = availableVariants.FirstOrDefault();

                    <div class="col-lg-4 col-md-6">
                        <div class="product-card">
                            <div class="product-image-wrap">
                                @if (product.IsBestseller)
                                {
                                    <span class="badge-bestseller">✦ БЕСТСЕЛЪР</span>
                                }
                                @if (product.HasDiscount)
                                {
                                    <span class="badge-discount">-@product.DiscountPercentage%</span>
                                }
                                <img src="@product.ImageUrl" alt="@product.Name" onerror="this.src='/images/Gemini_Generated_Image_8993a18993a18993.jpg'">

                                <div class="card-actions-hover">
                                    <a asp-action="Details" asp-route-id="@product.Id"
                                       class="btn btn-outline-gold btn-sm flex-grow-1" style="font-size:0.7rem; padding:8px 12px;">
                                        Преглед
                                    </a>
                                    <button type="button" class="btn btn-gold btn-sm"
                                            onclick="addToCart('@product.Id', 1, '@(defaultVariant?.Id.ToString() ?? "")')"
                                            title="Добави в количката" style="padding:8px 14px;">
                                        <i class="bi bi-bag-plus"></i>
                                    </button>
                                </div>
                            </div>

                            <div class="product-body">
                                <div class="product-brand">@product.Brand</div>
                                <h3 class="product-title">
                                    <a asp-action="Details" asp-route-id="@product.Id" style="color:inherit; text-decoration:none;">
                                        @product.Name
                                    </a>
                                </h3>
                                <div class="product-meta">
                                    <span class="badge-concentration me-1">@product.Concentration</span>
                                    @if (availableVariants.Count > 1)
                                    {
                                        <span style="color:#666; font-size:0.72rem;">@availableVariants.Count размера</span>
                                    }
                                    else if (availableVariants.Count == 1)
                                    {
                                        <span>@availableVariants[0].SizeMl ml</span>
                                    }
                                    else
                                    {
                                        <span>@product.Size</span>
                                    }
                                </div>

                                @if (!string.IsNullOrEmpty(product.Description))
                                {
                                    <p style="color:#888; font-size:0.83rem; line-height:1.6; margin-bottom:15px; flex-grow:1;">
                                        @(product.Description.Length > 95 ? product.Description[..95] + "…" : product.Description)
                                    </p>
                                }

                                <div class="product-price-row">
                                    <div>
                                        <span class="current-price">
                                            @if (availableVariants.Count > 1)
                                            {
                                                <span style="font-size:0.75rem; font-weight:400; opacity:0.7;">от </span>
                                            }
                                            @startPrice.ToString("F2") €
                                        </span>
                                        @if (product.HasDiscount)
                                        {
                                            <span class="original-price">@product.OriginalPrice!.Value.ToString("F2") €</span>
                                        }
                                        <div style="font-size:0.75rem; color:var(--text-muted); margin-top:2px; opacity:0.75;">
                                            @if (availableVariants.Count > 1)
                                            {
                                                <span>от </span>
                                            }
                                            @CurrencyHelper.FormatBgn(startPrice)
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>
