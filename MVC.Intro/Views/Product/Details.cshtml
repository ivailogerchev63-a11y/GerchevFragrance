@model MVC.Intro.Models.Product
@using MVC.Intro.Helpers
@{
    ViewData["Title"] = Model.Name;
    Layout = "~/Views/Shared/_Layout.cshtml";
    var related = ViewBag.RelatedProducts as List<MVC.Intro.Models.Product>;
    var hasVariants = Model.Variants != null && Model.Variants.Any();
    var availableVariants = hasVariants
        ? Model.Variants.Where(v => v.IsAvailable).OrderBy(v => v.SizeMl).ToList()
        : new List<MVC.Intro.Models.ProductVariant>();
    var defaultVariant = availableVariants.FirstOrDefault();
    var defaultPrice = defaultVariant?.Price ?? Model.Price;
    var defaultVariantId = defaultVariant?.Id ?? Guid.Empty;
}

<section style="padding: 60px 0 120px;">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <a asp-action="Index" style="color:var(--gold); text-decoration:none; font-size:0.78rem; letter-spacing:2px; text-transform:uppercase;">
                ← Назад към колекцията
            </a>
            <span style="color:#777; font-size:0.75rem;">
                Категория: <strong style="color:#aaa;">@(Model.Category ?? "Луксозни")</strong>
            </span>
        </div>
        <hr class="divider-gold" style="width:100%; margin:15px 0 40px;">

        <div class="row g-5 align-items-center mb-5">
            <!-- Product Image Showcase -->
            <div class="col-lg-5 text-center">
                <div style="border:1px solid var(--dark-border); background:radial-gradient(circle, #1a1a1a 0%, #0d0d0d 100%); padding:30px; position:relative;">
                    @if (Model.IsBestseller)
                    {
                        <span class="badge-bestseller">✦ БЕСТСЕЛЪР</span>
                    }
                    @if (Model.HasDiscount)
                    {
                        <span class="badge-discount">-@Model.DiscountPercentage%</span>
                    }
                    <img src="@Model.ImageUrl" alt="@Model.Name"
                         style="width:100%; max-height:480px; object-fit:contain; filter:drop-shadow(0 15px 25px rgba(0,0,0,0.8));"
                         onerror="this.src='/images/Gemini_Generated_Image_8993a18993a18993.jpg'">
                </div>
            </div>

            <!-- Product Details & Purchase Form -->
            <div class="col-lg-7">
                <p style="color:var(--gold); letter-spacing:4px; text-transform:uppercase; font-size:0.75rem; margin-bottom:8px; font-weight:600;">
                    @Model.Brand
                </p>
                <h1 style="font-family:var(--font-serif); font-size:clamp(2.2rem, 3.8vw, 3rem); color:#f0ead6; margin-bottom:8px;">
                    @Model.Name
                </h1>

                <div class="d-flex gap-3 mb-4 flex-wrap align-items-center">
                    <span class="badge-concentration" style="border:1px solid var(--gold); color:var(--gold); font-size:0.75rem; padding:4px 12px;">
                        @Model.Concentration
                    </span>
                    @if (!string.IsNullOrEmpty(Model.FragranceFamily))
                    {
                        <span style="color:#888; font-size:0.82rem; border:1px solid #333; padding:3px 10px;">@Model.FragranceFamily</span>
                    }
                    @if (Model.StockQuantity > 0 || availableVariants.Any())
                    {
                        <span style="color:#6dbf67; font-size:0.85rem;">● В наличност</span>
                    }
                    else
                    {
                        <span style="color:#bf6767; font-size:0.85rem;">● Изчерпан</span>
                    }
                </div>

                <p style="color:#bbb; line-height:1.9; font-size:0.98rem; max-width:550px; margin-bottom:28px;">
                    @Model.Description
                </p>

                <!-- Olfactory Breakdown -->
                @if (!string.IsNullOrEmpty(Model.Notes))
                {
                    <div class="mb-4 p-3" style="background:var(--dark-card); border-left:2px solid var(--gold);">
                        <div style="color:var(--gold); font-size:0.72rem; letter-spacing:2px; text-transform:uppercase; margin-bottom:8px; font-weight:600;">
                            Олфактивна Пирамида:
                        </div>
                        <div style="color:#ccc; font-size:0.85rem; line-height:1.7;">
                            @foreach (var notePart in Model.Notes.Split('|'))
                            {
                                <div>@notePart.Trim()</div>
                            }
                        </div>
                    </div>
                }

                <!-- Size Selector -->
                @if (availableVariants.Any())
                {
                    <div class="mb-4">
                        <label style="color:#aaa; font-size:0.75rem; letter-spacing:2px; text-transform:uppercase; display:block; margin-bottom:10px;">
                            Изберете размер:
                        </label>
                        <div class="d-flex flex-wrap gap-2" id="sizeSelector">
                            @foreach (var variant in availableVariants)
                            {
                                var isFirst = variant == availableVariants.First();
                                <button type="button"
                                        class="btn size-btn @(isFirst ? "size-btn-active" : "")"
                                        data-variant-id="@variant.Id"
                                        data-size="@variant.SizeMl ml"
                                        data-price="@variant.Price.ToString("F2")"
                                        data-has-discount="@(variant.HasDiscount ? "true" : "false")"
                                        data-original-price="@(variant.OriginalPrice?.ToString("F2") ?? "")"
                                        style="border:1px solid @(isFirst ? "var(--gold)" : "#444"); color:@(isFirst ? "var(--gold)" : "#888"); background:@(isFirst ? "rgba(201,168,76,0.1)" : "transparent"); padding:8px 20px; font-size:0.82rem; letter-spacing:1px; transition:all 0.2s;">
                                    @variant.SizeMl ml
                                    <span style="display:block; font-size:0.72rem; margin-top:2px; opacity:0.8;">@variant.Price.ToString("F2") €</span>
                                    <span style="display:block; font-size:0.68rem; opacity:0.55;">@CurrencyHelper.FormatBgn(variant.Price)</span>
                                </button>
                            }
                        </div>
                    </div>
                }

                <!-- Pricing (dynamic) -->
                <div class="mb-4" id="priceDisplay">
                    <div class="d-flex align-items-baseline gap-3">
                        <span id="currentPriceDisplay" style="font-family:var(--font-serif); font-size:2.5rem; color:var(--gold); font-weight:700;">
                            @defaultPrice.ToString("F2") €
                        </span>
                        <span id="originalPriceDisplay" style="color:#777; text-decoration:line-through; font-size:1.2rem; display:@(defaultVariant?.HasDiscount == true ? "inline" : "none")">
                            @(defaultVariant?.OriginalPrice?.ToString("F2") ?? "") €
                        </span>
                    </div>
                    <div id="bgnPriceDisplay" style="color:#888; font-size:0.9rem; margin-top:4px;">
                        @CurrencyHelper.FormatBgn(defaultPrice)
                    </div>
                </div>

                <!-- Quantity & Add to Cart Form -->
                <div class="d-flex gap-3 align-items-center flex-wrap mb-4">
                    <div class="d-flex align-items-center" style="border:1px solid #444; background:var(--dark-card);">
                        <button type="button" class="btn text-white px-3" onclick="decrementQty()">−</button>
                        <input type="number" id="detailQty" value="1" min="1" max="10"
                               style="width:50px; text-align:center; background:none; border:none; color:var(--gold); font-weight:700;" readonly>
                        <button type="button" class="btn text-white px-3" onclick="incrementQty()">+</button>
                    </div>

                    <button type="button" class="btn btn-gold py-3 px-4" onclick="addCurrentProduct()" style="letter-spacing:2px;">
                        <i class="bi bi-bag-plus"></i> Добави в Количката
                    </button>
                </div>

                <div class="p-3" style="background:#0f0f0f; border:1px solid #222; font-size:0.8rem; color:#888;">
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <i class="bi bi-shield-check text-warning"></i> 100% Оригинален продукт с гарантиран произход
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-truck text-warning"></i> Бърза куриерска доставка с опция за преглед
                    </div>
                </div>
            </div>
        </div>

        <!-- Related Products Section -->
        @if (related != null && related.Any())
        {
            <div class="mt-5 pt-5 border-top border-secondary border-opacity-25">
                <div class="text-center mb-5">
                    <p style="color:var(--gold); letter-spacing:4px; text-transform:uppercase; font-size:0.75rem;">
                        — Може да харесате още —
                    </p>
                    <h3 style="font-family:var(--font-serif); color:#f0ead6; font-size:2rem;">
                        Свързани Аромати
                    </h3>
                </div>

                <div class="row g-4 justify-content-center">
                    @foreach (var p in related)
                    {
                        var relatedStartPrice = p.Variants.Any() ? p.Variants.Where(v => v.IsAvailable).Min(v => v.Price) : p.Price;
                        var relatedDefaultVariant = p.Variants.Where(v => v.IsAvailable).OrderBy(v => v.SizeMl).FirstOrDefault();
                        <div class="col-md-4">
                            <div class="product-card">
                                <div class="product-image-wrap">
                                    <img src="@p.ImageUrl" alt="@p.Name" onerror="this.src='/images/Gemini_Generated_Image_8993a18993a18993.jpg'">
                                    <div class="card-actions-hover">
                                        <a asp-action="Details" asp-route-id="@p.Id" class="btn btn-outline-gold btn-sm flex-grow-1">
                                            Преглед
                                        </a>
                                        <button type="button" class="btn btn-gold btn-sm"
                                                onclick="addToCart('@p.Id', 1, '@(relatedDefaultVariant?.Id.ToString() ?? "")')">
                                            <i class="bi bi-bag-plus"></i>
                                        </button>
                                    </div>
                                </div>
                                <div class="product-body">
                                    <div class="product-brand">@p.Brand</div>
                                    <h4 class="product-title" style="font-size:1.05rem;">
                                        <a asp-action="Details" asp-route-id="@p.Id" style="color:inherit; text-decoration:none;">
                                            @p.Name
                                        </a>
                                    </h4>
                                    <div class="product-meta">
                                        <span>@p.Concentration</span>
                                    </div>
                                    <div class="product-price-row">
                                        <span class="current-price">
                                            @if (p.Variants.Any())
                                            {
                                                <span>от </span>
                                            }
                                            @relatedStartPrice.ToString("F2") €
                                        </span>
                                        <div style="font-size:0.75rem; color:var(--text-muted); margin-top:2px; opacity:0.75;">
                                            @if (p.Variants.Any()) { <span>от </span> }
                                            @CurrencyHelper.FormatBgn(relatedStartPrice)
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</section>

<style>
    .size-btn-active {
        border-color: var(--gold) !important;
        color: var(--gold) !important;
        background: rgba(201,168,76,0.12) !important;
    }
    .size-btn:hover {
        border-color: var(--gold) !important;
        color: var(--gold) !important;
        background: rgba(201,168,76,0.08) !important;
    }
</style>

@section Scripts {
    <script>
        var selectedVariantId = '@defaultVariantId';
        var productId = '@Model.Id';

        // Size selector logic
        document.querySelectorAll('.size-btn').forEach(function(btn) {
            btn.addEventListener('click', function() {
                // Update active state
                document.querySelectorAll('.size-btn').forEach(b => b.classList.remove('size-btn-active'));
                this.classList.add('size-btn-active');

                // Update selected variant
                selectedVariantId = this.dataset.variantId;
                var price = parseFloat(this.dataset.price);
                var hasDiscount = this.dataset.hasDiscount === 'true';
                var originalPrice = this.dataset.originalPrice;

                // Update EUR price display
                document.getElementById('currentPriceDisplay').textContent = price.toFixed(2) + ' €';

                // Update BGN price display (1 EUR = 1.95583 BGN)
                var bgn = (price * 1.95583).toFixed(2);
                document.getElementById('bgnPriceDisplay').textContent = bgn + ' лв';

                var origDisplay = document.getElementById('originalPriceDisplay');
                if (hasDiscount && originalPrice) {
                    origDisplay.textContent = originalPrice + ' €';
                    origDisplay.style.display = 'inline';
                } else {
                    origDisplay.style.display = 'none';
                }
            });
        });

        function incrementQty() {
            var val = parseInt($('#detailQty').val()) || 1;
            if (val < 10) $('#detailQty').val(val + 1);
        }
        function decrementQty() {
            var val = parseInt($('#detailQty').val()) || 1;
            if (val > 1) $('#detailQty').val(val - 1);
        }
        function addCurrentProduct() {
            var qty = parseInt($('#detailQty').val()) || 1;
            addToCart(productId, qty, selectedVariantId);
        }
    </script>
}
