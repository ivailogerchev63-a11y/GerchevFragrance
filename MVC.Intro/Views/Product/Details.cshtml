@model MVC.Intro.Models.Product
@{
    ViewData["Title"] = Model.Name;
    Layout = "~/Views/Shared/_Layout.cshtml";
    var related = ViewBag.RelatedProducts as List<MVC.Intro.Models.Product>;
}

<section style="padding: 60px 0 120px;">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <a asp-action="Index" style="color:var(--gold); text-decoration:none; font-size:0.78rem; letter-spacing:2px; text-transform:uppercase;">
                ← Назад към колекцията
            </a>
            <span style="color:#777; font-size:0.75rem;">
                Категория: <strong style="color:#aaa;">@(Model.Category ?? "Луксозни")</strong>
            </span>
        </div>
        <hr class="divider-gold" style="width:100%; margin:15px 0 40px;">

        <div class="row g-5 align-items-center mb-5">
            <!-- Product Image Showcase -->
            <div class="col-lg-5 text-center">
                <div style="border:1px solid var(--dark-border); background:radial-gradient(circle, #1a1a1a 0%, #0d0d0d 100%); padding:30px; position:relative;">
                    @if (Model.IsBestseller)
                    {
                        <span class="badge-bestseller">✦ БЕСТСЕЛЪР</span>
                    }
                    @if (Model.HasDiscount)
                    {
                        <span class="badge-discount">-@Model.DiscountPercentage%</span>
                    }
                    <img src="@Model.ImageUrl" alt="@Model.Name"
                         style="width:100%; max-height:480px; object-fit:contain; filter:drop-shadow(0 15px 25px rgba(0,0,0,0.8));"
                         onerror="this.src='/images/images.jpg'">
                </div>
            </div>

            <!-- Product Details & Purchase Form -->
            <div class="col-lg-7">
                <p style="color:var(--gold); letter-spacing:4px; text-transform:uppercase; font-size:0.75rem; margin-bottom:8px; font-weight:600;">
                    @Model.Brand
                </p>
                <h1 style="font-family:var(--font-serif); font-size:clamp(2.2rem, 3.8vw, 3rem); color:#f0ead6; margin-bottom:16px;">
                    @Model.Name
                </h1>

                <div class="d-flex gap-3 mb-4 flex-wrap align-items-center">
                    <span class="badge-concentration" style="border:1px solid var(--gold); color:var(--gold); font-size:0.75rem; padding:4px 12px;">
                        @Model.Concentration
                    </span>
                    <span style="color:#888; font-size:0.85rem;">Размер: @Model.Size</span>
                    @if (Model.StockQuantity > 0)
                    {
                        <span style="color:#6dbf67; font-size:0.85rem;">● В наличност (@Model.StockQuantity бр.)</span>
                    }
                    else
                    {
                        <span style="color:#bf6767; font-size:0.85rem;">● Изчерпан</span>
                    }
                </div>

                <p style="color:#bbb; line-height:1.9; font-size:0.98rem; max-width:550px; margin-bottom:28px;">
                    @Model.Description
                </p>

                <!-- Olfactory Breakdown -->
                @if (!string.IsNullOrEmpty(Model.Notes))
                {
                    <div class="mb-4 p-3" style="background:var(--dark-card); border-left:2px solid var(--gold);">
                        <div style="color:var(--gold); font-size:0.72rem; letter-spacing:2px; text-transform:uppercase; margin-bottom:8px; font-weight:600;">
                            Олфактивна Композиция:
                        </div>
                        <div style="color:#ccc; font-size:0.85rem; line-height:1.7;">
                            @Model.Notes
                        </div>
                    </div>
                }

                <!-- Pricing -->
                <div class="d-flex align-items-baseline gap-3 mb-4">
                    <span style="font-family:var(--font-serif); font-size:2.5rem; color:var(--gold); font-weight:700;">
                        @CurrencyHelper.FormatEuro(Model.Price)
                    </span>
                    @if (Model.HasDiscount)
                    {
                        <span style="color:#777; text-decoration:line-through; font-size:1.2rem;">
                            @CurrencyHelper.FormatEuro(Model.OriginalPrice!.Value)
                        </span>
                        <span class="badge bg-danger">Спестявате @CurrencyHelper.FormatEuro(Model.SavingsAmount)</span>
                    }
                </div>

                <!-- Add to Cart Form -->
                <div class="d-flex gap-3 align-items-center flex-wrap mb-4">
                    <div class="d-flex align-items-center" style="border:1px solid #444; background:var(--dark-card);">
                        <button type="button" class="btn text-white px-3" onclick="decrementQty()">−</button>
                        <input type="number" id="detailQty" value="1" min="1" max="@Model.StockQuantity" 
                               style="width:50px; text-align:center; background:none; border:none; color:var(--gold); font-weight:700;" readonly>
                        <button type="button" class="btn text-white px-3" onclick="incrementQty()">+</button>
                    </div>

                    <button type="button" class="btn btn-gold py-3 px-4" onclick="addCurrentProduct()" style="letter-spacing:2px;">
                        <i class="bi bi-bag-plus"></i> Добави в Количката
                    </button>
                </div>

                <div class="p-3" style="background:#0f0f0f; border:1px solid #222; font-size:0.8rem; color:#888;">
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <i class="bi bi-shield-check text-warning"></i> 100% Оригинален продукт с гарантиран произход
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-truck text-warning"></i> Бърза куриерска доставка с опция за преглед
                    </div>
                </div>
            </div>
        </div>

        <!-- Related Products Section -->
        @if (related != null && related.Any())
        {
            <div class="mt-5 pt-5 border-top border-secondary border-opacity-25">
                <div class="text-center mb-5">
                    <p style="color:var(--gold); letter-spacing:4px; text-transform:uppercase; font-size:0.75rem;">
                        — Може да харесате още —
                    </p>
                    <h3 style="font-family:var(--font-serif); color:#f0ead6; font-size:2rem;">
                        Свързани Аромати
                    </h3>
                </div>

                <div class="row g-4 justify-content-center">
                    @foreach (var p in related)
                    {
                        <div class="col-md-4">
                            <div class="product-card">
                                <div class="product-image-wrap">
                                    <img src="@p.ImageUrl" alt="@p.Name" onerror="this.src='/images/images.jpg'">
                                    <div class="card-actions-hover">
                                        <a asp-action="Details" asp-route-id="@p.Id" class="btn btn-outline-gold btn-sm flex-grow-1">
                                            Преглед
                                        </a>
                                        <button type="button" class="btn btn-gold btn-sm" onclick="addToCart('@p.Id')">
                                            <i class="bi bi-bag-plus"></i>
                                        </button>
                                    </div>
                                </div>
                                <div class="product-body">
                                    <div class="product-brand">@p.Brand</div>
                                    <h4 class="product-title" style="font-size:1.05rem;">
                                        <a asp-action="Details" asp-route-id="@p.Id" style="color:inherit; text-decoration:none;">
                                            @p.Name
                                        </a>
                                    </h4>
                                    <div class="product-meta">
                                        <span>@p.Concentration · @p.Size</span>
                                    </div>
                                    <div class="product-price-row">
                                        <span class="current-price">@CurrencyHelper.FormatEuro(p.Price)</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</section>

@section Scripts {
    <script>
        function incrementQty() {
            var val = parseInt($('#detailQty').val()) || 1;
            $('#detailQty').val(val + 1);
        }
        function decrementQty() {
            var val = parseInt($('#detailQty').val()) || 1;
            if (val > 1) $('#detailQty').val(val - 1);
        }
        function addCurrentProduct() {
            var qty = parseInt($('#detailQty').val()) || 1;
            addToCart('@Model.Id', qty);
        }
    </script>
}
